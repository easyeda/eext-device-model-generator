{
  "name": "eext-device-model-generator",
  "version": "1.11.5",
  "private": true,
  "description": "从器件数据手册生成 3D 预览和 STEP 的嘉立创EDA扩展",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.17.0"
  },
  "scripts": {
    "compile": "rimraf ./dist/ && node --import ./config/register-ts-node.mjs ./config/esbuild.prod.ts",
    "postcompile": "node ./config/build-assets.mjs",
    "build": "npm run compile && node --import ./config/register-ts-node.mjs ./build/packaged.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pdfjs-dist": "^5.4.624",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@jlceda/pro-api-types": "^0.4.29",
    "@types/fs-extra": "^11.0.4",
    "esbuild": "^0.28.2",
    "fs-extra": "^11.3.0",
    "ignore": "^7.0.3",
    "jszip": "^3.10.2",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
